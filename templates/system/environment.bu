---
# System Environment Variables Configuration
## Injects global system-wide environment variables via systemd environment.d
## drop-in files based on encrypted server state key-value pairs.

variant: fcos
version: 1.6.0

storage:
  files:
    {%- if configuration.variables is defined and configuration.variables | length > 0 %}
    - path: /etc/environment
      overwrite: true
      contents:
        inline: |
          # Automatically generated global system environment variables
          {%- for key, value in configuration.variables.items() %}
          {{ key }}={{ value }}
          {%- endfor %}
      user:
        name: root
      group:
        name: root
      mode: 0600
    {%- endif %}
