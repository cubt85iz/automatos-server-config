---
# SSH Host Keys Configuration
## Persists cryptographic SSH host keys to maintain server identity across reprovisioning
## based on encrypted server state variables.

variant: fcos
version: 1.6.0

storage:
  files:
    {%- for key in configuration.security.ssh_host_keys %}
    - path: /etc/ssh/ssh_host_{{ key.type }}_key
      overwrite: true
      contents:
        inline: |
          {{ key.private | indent(10) }}
      user:
        name: root
      group:
        name: root
      mode: 0600

    - path: /etc/ssh/ssh_host_{{ key.type }}_key.pub
      overwrite: true
      contents:
        inline: |
          {{ key.public }}
      user:
        name: root
      group:
        name: root
      mode: 0644
    {%- endfor %}
