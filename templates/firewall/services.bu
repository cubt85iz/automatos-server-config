---
# Networking Firewall Configuration
## Dynamically generates individual firewalld service definition files and
## configures the default 'public' zone based on encrypted server state variables.
## This securely manages service ports and exposures without leaking metadata
## or application names into version control.

variant: fcos
version: 1.6.0

storage:
  files:
    {%- for service in configuration.firewall.services %}
    - path: /etc/firewalld/services/{{ service.name }}.xml
      overwrite: true
      contents:
        inline: |
          <?xml version="1.0" encoding="utf-8"?>
          <service>
            <short>{{ service.display_name }}</short>
            <description>{{ service.description }}</description>
            <port protocol="tcp" port="{{ service.port }}"/>
          </service>
      user:
        name: root
      group:
        name: root
      mode: 0644
    {%- endfor %}
