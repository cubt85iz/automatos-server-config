---
# System Directories Configuration
## Provisions required directory paths with specified permissions and ownership
## based on encrypted server state variables.

variant: fcos
version: 1.6.0

storage:
  directories:
    {%- if configuration.storage is defined and configuration.storage.directories is defined %}
    {%- for dir in configuration.storage.directories %}
    - path: {{ dir.path }}
      overwrite: {{ dir.overwrite | default(true) | string | lower }}
      user:
        name: {{ dir.user | default('root') }}
      group:
        name: {{ dir.group | default('root') }}
      mode: {{ dir.mode | default('0755') }}
    {%- endfor %}
    {%- endif %}
