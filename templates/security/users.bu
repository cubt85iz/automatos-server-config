---
# User Accounts Configuration
## Manages local system user accounts, password hashes, and authorized SSH keys
## based on encrypted server state variables.

variant: fcos
version: 1.6.0

passwd:
  users:
    {%- if configuration.users is defined and configuration.users | length > 0 %}
    {%- for user in configuration.users %}
    - name: {{ user.name }}
      {%- if user.password_hash is defined %}
      password_hash: "{{ user.password_hash }}"
      {%- endif %}
      {%- if user.ssh_authorized_keys is defined and user.ssh_authorized_keys | length > 0 %}
      ssh_authorized_keys:
        {%- for key in user.ssh_authorized_keys %}
        - "{{ key }}"
        {%- endfor %}
      {%- endif %}
    {%- endfor %}
    {%- endif %}
