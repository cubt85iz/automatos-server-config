---
# Container Execution Commands Configuration
## Configures the container's command-line arguments via a systemd-container drop-in file
## based on encrypted server state variables.

variant: fcos
version: 1.6.0

storage:
  files:
    {%- for container in configuration.services.containers %}
    {%- if container.command is defined %}
    - path: /etc/containers/systemd/{{ container.name }}/{{ container.name }}.container.d/commands.conf
      overwrite: true
      contents:
        inline: |
          [Container]
          Exec={{ container.command | indent(10) }}
      user:
        name: root
      group:
        name: root
      mode: 0644
    {%- endif %}
    {%- endfor %}
