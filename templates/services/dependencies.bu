---
# Container Service Dependencies Configuration
## Configures service startup dependencies via a systemd-container drop-in file
## based on encrypted server state variables.

variant: fcos
version: 1.6.0

storage:
  files:
    {%- for container in configuration.services.containers %}
    {%- if container.dependencies is defined and container.dependencies.after is defined %}
    - path: /etc/containers/systemd/{{ container.name }}/{{ container.name }}.container.d/dependencies.conf
      overwrite: true
      contents:
        inline: |
          [Unit]
          # Ensure required services are active before starting the container
          After={{ container.dependencies.after | join(' ') }}
      user:
        name: root
      group:
        name: root
      mode: 0644
    {%- endif %}
    {%- endfor %}
