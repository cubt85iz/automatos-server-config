---
# Container Network Assignment Configuration
## Dynamically assigns containers to their respective virtual networks
## via systemd-container drop-in files based on the inverted network-to-container mapping.

variant: fcos
version: 1.6.0

storage:
  files:
    {#- Step 1: Collect a unique list of all containers across all networks #}
    {%- set ns = namespace(all_containers=[]) %}
    {%- for net in configuration.services.networks %}
      {%- if net.containers is defined %}
        {%- for container_name in net.containers %}
          {%- if container_name not in ns.all_containers %}
            {%- set ns.all_containers = ns.all_containers + [container_name] %}
          {%- endif %}
        {%- endfor %}
      {%- endif %}
    {%- endfor %}
    {#- Step 2: Generate the networks.conf drop-in for each unique container #}
    {%- for container_name in ns.all_containers %}
    - path: /etc/containers/systemd/{{ container_name }}/{{ container_name }}.container.d/networks.conf
      overwrite: true
      contents:
        inline: |
          [Container]
          {%- for net in configuration.services.networks %}
          {%- if net.containers is defined and container_name in net.containers %}
          Network={{ net.name }}-network
          {%- endif %}
          {%- endfor %}
      user:
        name: root
      group:
        name: root
      mode: 0644
    {%- endfor %}
