---
# Container Device Configuration
## Configures hardware device access via a systemd-container drop-in file
## for containers requiring specialized hardware (such as GPUs via CDI).

variant: fcos
version: 1.6.0

storage:
  files:
    {%- for container in configuration.services.containers %}
    {%- if container.devices is defined and container.devices | length > 0 %}
    - path: /etc/containers/systemd/{{ container.name }}/{{ container.name }}.container.d/devices.conf
      overwrite: true
      contents:
        inline: |
          [Unit]
          # Ensure NVIDIA CDI (Container Device Interface) resources are refreshed
          # before the container attempts to start to prevent device initialization errors.
          Requires=nvidia-cdi-refresh.service
          After=nvidia-cdi-refresh.service

          [Container]
          # Grant the container access to specified hardware devices
          {%- for device in container.devices %}
          AddDevice={{ device }}
          {%- endfor %}
      user:
        name: root
      group:
        name: root
      mode: 0644
    {%- endif %}
    {%- endfor %}
