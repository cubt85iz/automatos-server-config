#!/usr/bin/env bash

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_DIR="$(dirname "$HOOK_DIR")"
CACHE_DIR="$PROFILE_DIR/.cache"

mkdir -p "$CACHE_DIR/bin"
echo "==> Downloading utilities for $(basename "$PROFILE_DIR")..."

# 1. Download latest chezmoi static binary
curl -sL https://github.com/twpayne/chezmoi/releases/latest/download/chezmoi-linux-amd64 -o "$CACHE_DIR/bin/chezmoi"

# 2. Download latest just static binary
JUST_VERSION=$(curl -sL https://api.github.com/repos/casey/just/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
curl -sL \
  "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz" | \
  tar -xz -C "$CACHE_DIR/bin" just

echo "==> Utilities cached successfully!"
