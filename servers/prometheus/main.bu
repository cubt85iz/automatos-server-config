---
# ==============================================================================
# SERVER PROVISIONING MANIFEST: .staging/prometheus
# This Jinja2 template orchestrates the Fedora CoreOS provisioning process.
#
# It manages the following configuration layers:
#   - Ignition Merges (Networking, Services, Backups, Devices)
#   - Storage Layout (Directories, Filesystem, Symlinks)
#   - User Authentication & Security (passwd/ssh)
# ==============================================================================
variant: fcos
version: 1.6.0

# ==============================================================================
# IGNITION MERGES FOR SERVER CONFIGURATION
# ==============================================================================
ignition:
  config:
    merge:

      # --- Backups ---
      - local: backups/targets.ign

      # --- Devices ---
      - local: devices/nvidia.ign

      # --- Firewall ---
      - local: firewall/services.ign
      - local: firewall/zones.ign

      # --- Networking ---
      - local: networking/assignments.ign
      - local: networking/nfs.ign

      # --- Security ---
      - local: security/ssh-access.ign
      - local: security/users.ign

      # --- Services ---
      - local: services/commands.ign
      - local: services/dependencies.ign
      - local: services/devices.ign
      - local: services/network.ign
      - local: services/properties.ign
      - local: services/security.ign
      - local: services/variables.ign

      # --- SSH ---
      - local: ssh/host-keys.ign

      # --- Storage ---
      - local: storage/directories.ign
      - local: storage/files.ign
      - local: storage/links.ign

      # --- System ---
      - local: system/environment.ign
      - local: system/units.ign
