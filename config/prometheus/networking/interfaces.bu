---
# Networking Interface Configuration
## Configures network interface naming via systemd-networkd .link files.
## This ensures predictable interface names (e.g., eth0, eth1) based on
## hardware MAC addresses, which is critical for consistent networking.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/systemd/network/10-eth0.link
      overwrite: true
      contents:
        inline: |
          [Match]
          MACAddress={{ ETH0_MAC_ADDRESS }}

          [Link]
          # Assign the specified name to this interface
          Name=eth0
      user:
        name: root
      group:
        name: root
      mode: 0644

    - path: /etc/systemd/network/10-eth1.link
      overwrite: true
      contents:
        inline: |
          [Match]
          MACAddress={{ ETH1_MAC_ADDRESS }}

          [Link]
          # Assign the specified name to this interface
          Name=eth1
      user:
        name: root
      group:
        name: root
      mode: 0644
