---
# SSH Configuration
## Manages SSH server access controls and persists host keys to maintain
## server identity across reprovisioning.

variant: fcos
version: 1.6.0

storage:
  files:
    # Access Control
    ## Restricts SSH access to local network subnets (LAN VLANs) to prevent
    ## unauthorized off-site access.
    - path: /etc/ssh/sshd_config.d/90-permit-only-local-access.conf
      overwrite: true
      contents:
        inline: |
          # Permit SSH access only from the LAN VLAN
          AllowUsers *@{{ LAN_VLAN }}
      user:
        name: root
      group:
        name: root
      mode: 0644

    # Host Keys
    ## Persists SSH host keys to ensure consistent identity across reprovisioning.
    ## NOTE: Key content must include a trailing newline for the SSH daemon to start.
    ## Do not use `|-` when specifying this content.
    - path: /etc/ssh/ssh_host_ecdsa_key
      overwrite: true
      contents:
        inline: |
          {{ SSH_HOST_ECDSA_KEY | indent(width=10) }}
      user:
        name: root
      group:
        name: root
      mode: 0600

    - path: /etc/ssh/ssh_host_ecdsa_key.pub
      overwrite: true
      contents:
        inline: |
          {{ SSH_HOST_ECDSA_KEY_PUB | indent(width=10) }}
      user:
        name: root
      group:
        name: root
      mode: 0644

    - path: /etc/ssh/ssh_host_ed25519_key
      overwrite: true
      contents:
        inline: |
          {{ SSH_HOST_ED25519_KEY | indent(width=10) }}
      user:
        name: root
      group:
        name: root
      mode: 0600

    - path: /etc/ssh/ssh_host_ed25519_key.pub
      overwrite: true
      contents:
        inline: |
          {{ SSH_HOST_ED25519_KEY_PUB | indent(width=10) }}
      user:
        name: root
      group:
        name: root
      mode: 0644

    - path: /etc/ssh/ssh_host_rsa_key
      overwrite: true
      contents:
        inline: |
          {{ SSH_HOST_RSA_KEY | indent(width=10) }}
      user:
        name: root
      group:
        name: root
      mode: 0600

    - path: /etc/ssh/ssh_host_rsa_key.pub
      overwrite: true
      contents:
        inline: |
          {{ SSH_HOST_RSA_KEY_PUB | indent(width=10) }}
      user:
        name: root
      group:
        name: root
      mode: 0644
