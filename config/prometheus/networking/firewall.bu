---
# Networking Firewall Configuration
## Configures the default 'public' zone for firewalld.
## This manages which services are exposed to the public network interface,
## including standard system services and application-specific ones.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/firewalld/zones/public.xml
      overwrite: true
      contents:
        inline: |
          <?xml version="1.0" encoding="utf-8"?>
          <zone>
            <short>Public</short>

            <!-- Standard system services -->
            <service name="dhcpv6-client"/>
            <service name="mdns"/>
            <service name="mountd"/>
            <service name="netbios-ns"/>
            <service name="nfs3"/>
            <service name="rpc-bind"/>
            <service name="ssh"/>

            <!-- Application-specific services -->
            <service name="uptime-kuma"/>
            <service name="open-webui"/>
            <service name="llama-cpp"/>
            <service name="wyoming-openai"/>

            <forward/>
          </zone>
      user:
        name: root
      group:
        name: root
      mode: 0644
