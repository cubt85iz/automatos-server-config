---
# Chatterbox-Turbo Container Configuration
## Configures device access (NVIDIA GPU) via a systemd-container drop-in file.
## This separate configuration allows the server maintainer to easily customize
## hardware access requirements without modifying the main container definition.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/containers/systemd/chatterbox-turbo/chatterbox-turbo.container.d/devices.conf
      overwrite: true
      contents:
        inline: |
          [Unit]
          # Ensure NVIDIA CDI resources are refreshed before the container attempts to start
          Requires=nvidia-cdi-refresh.service
          After=nvidia-cdi-refresh.service

          [Container]
          # Grant the container access to all available NVIDIA GPUs
          AddDevice=nvidia.com/gpu=all
      user:
        name: root
      group:
        name: root
      mode: 0644
