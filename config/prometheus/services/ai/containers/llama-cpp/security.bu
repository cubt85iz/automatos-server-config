---
# Llama.cpp Security Configuration
## Configures security hardening and isolation via a systemd-container drop-in file.
## This allows the server maintainer to enforce strict security constraints
## (such as capability dropping and user namespace isolation) at the configuration level.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/containers/systemd/llama-cpp/llama-cpp.container.d/security.conf
      overwrite: true
      contents:
        inline: |
          [Container]
          # Enable automatic user namespace mapping for enhanced process isolation
          UserNS=auto
          # Run the container as a non-root user (UID/GID 1000)
          User=1000:1000
          # Remove all kernel capabilities to follow the principle of least privilege
          DropCapability=ALL
          # Prevent processes from gaining new privileges (e.g., via setuid/setgid)
          NoNewPrivileges=true
          # Limit the maximum number of processes to mitigate fork-bomb/DoS attacks
          PidsLimit=2048
      user:
        name: root
      group:
        name: root
      mode: 0644
