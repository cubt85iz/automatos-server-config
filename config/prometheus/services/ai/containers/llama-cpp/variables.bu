---
# Llama.cpp Environment Variables
## Configures environment variables via a systemd-container drop-in file.
## This allows the server maintainer to tune application settings (such as
## volume paths or network ports) without modifying the base container definition.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/containers/systemd/llama-cpp/llama-cpp.container.d/variables.conf
      overwrite: true
      contents:
        inline: |
          [Service]
          # Define the internal path used by the application for volume management
          Environment=CONTAINER_PATH={{ CONTAINER_VOLUME_ROOT }}/volumes/llama-cpp
          # Define the port on which the web/API service listens
          Environment=WEB_PORT={{ LLAMA_CPP_PORT }}
      user:
        name: root
      group:
        name: root
      mode: 0644
