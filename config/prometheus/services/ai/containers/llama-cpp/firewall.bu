---
# Llama.cpp Firewall Configuration
## Creates a custom firewalld service definition to permit traffic to the
## Llama.cpp API. This allows the service to be managed easily via firewalld.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/firewalld/services/llama-cpp.xml
      overwrite: true
      contents:
        inline: |
          <?xml version="1.0" encoding="utf-8"?>
          <service>
            <short>Llama.cpp</short>
            <description>Llama.cpp local inference API service</description>
            <port protocol="tcp" port="{{ LLAMA_CPP_PORT }}"/>
          </service>
      user:
        name: root
      group:
        name: root
      mode: 0644
