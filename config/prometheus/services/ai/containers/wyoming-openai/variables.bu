---
# Wyoming-OpenAI Environment Variables
## Configures environment variables via a systemd-container drop-in file.
## This allows the server maintainer to tune application configuration (such as
## connection strings, log levels, or model selection) without modifying
## the primary container definition.

variant: fcos
version: 1.6.0

storage:
  files:
    - path: /etc/containers/systemd/wyoming-openai/wyoming-openai.container.d/variables.conf
      overwrite: true
      contents:
        inline: |
          [Container]
          Environment=WYOMING_URI={{ WYOMING_OPENAI_URI }}
          Environment=WYOMING_LOG_LEVEL=INFO
          Environment=WYOMING_LANGUAGES=en

          # Speech-to-Text (STT) configuration
          Environment=STT_OPENAI_URL=http://parakeet:5092/v1
          Environment=STT_MODELS=whisper-1
          Environment=STT_BACKEND=OPENAI

          # Text-to-Speech (TTS) configuration
          Environment=TTS_OPENAI_URL=http://chatterbox-turbo:8004/v1
          Environment=TTS_MODELS=chatterbox-turbo
          Environment=TTS_BACKEND=OPENAI

          [Service]
          Environment=WEB_PORT={{ WYOMING_OPENAI_PORT }}
      user:
        name: root
      group:
        name: root
      mode: 0644
