{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Automatos Server Configuration Schema",
  "type": "object",
  "required": [
    "configuration",
    "storage",
    "users",
    "variables"
  ],
  "properties": {
    "configuration": {
      "type": "object",
      "required": [
        "firewall",
        "networking",
        "security",
        "services"
      ],
      "properties": {
        "firewall": {
          "type": "object",
          "required": [
            "services",
            "zones"
          ],
          "properties": {
            "services": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "display_name",
                  "description",
                  "port"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "display_name": { "type": "string" },
                  "description": { "type": "string" },
                  "port": { "type": "integer" }
                }
              }
            },
            "zones": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "display_name",
                  "description",
                  "services"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "display_name": { "type": "string" },
                  "description": { "type": "string" },
                  "services": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "networking": {
          "type": "object",
          "required": [
            "interfaces",
            "vlans"
          ],
          "properties": {
            "interfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "mac"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "mac": { "type": "string", "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$" }
                }
              }
            },
            "vlans": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "security": {
          "type": "object",
          "required": [
            "ssh_host_keys"
          ],
          "properties": {
            "ssh_host_keys": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "public"
                ],
                "properties": {
                  "type": { "enum": ["ecdsa", "ed25519", "rsa"] },
                  "private": { "type": "string" },
                  "public": { "type": "string" }
                }
              }
            }
          }
        },
        "services": {
          "type": "object",
          "required": [
            "containers",
            "networks"
          ],
          "properties": {
            "containers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "auto_update"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "auto_update": { "type": "string" },
                  "command": { "type": "string" },
                  "dependencies": {
                    "type": "object",
                    "properties": {
                      "after": { "type": "array", "items": { "type": "string" } },
                      "requires": { "type": "array", "items": { "type": "string" } }
                    }
                  },
                  "devices": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "security": {
                    "type": "object",
                    "properties": {
                      "user_ns": { "type": "string" },
                      "user": { "type": "string" },
                      "drop_capability": { "type": "array", "items": { "type": "string" } },
                      "no_new_privileges": { "type": "boolean" },
                      "pids_limit": { "type": "integer" }
                    }
                  },
                  "variables": {
                    "type": "object",
                    "properties": {
                      "container": { "type": "object", "additionalProperties": { "type": "string" } },
                      "service": { "type": "object", "additionalProperties": { "type": "string" } }
                    },
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            },
            "networks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "subnet",
                  "containers"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "subnet": { "type": "string" },
                  "containers": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "directories",
        "files",
        "links",
        "pools"
      ],
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "user",
              "group"
            ],
            "properties": {
              "path": { "type": "string" },
              "user": { "type": "string" },
              "group": { "type": "string" }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "contents",
              "user",
              "group"
            ],
            "properties": {
              "path": { "type": "string" },
              "contents": { "type": "string" },
              "user": { "type": "string" },
              "group": { "type": "string" },
              "mode": { "type": "string" }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "target"
            ],
            "properties": {
              "path": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "mountpoint"
            ],
            "properties": {
              "name": { "type": "string" },
              "mountpoint": { "type": "string" }
            }
          }
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": { "type": "string" },
          "password_hash": { "type": "string" },
          "ssh_authorized_keys": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "object"] }
    }
  }
}